        <mxCell id="p3-base-t" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;font-family:'Microsoft YaHei','PingFang SC','Hiragino Sans GB','Noto Sans CJK SC',sans-serif;font-size:18px;color:#5A6B80;font-weight:700&quot;&gt;07 调色板 ＋ 09 主题&lt;/span&gt;&lt;span style=&quot;font-family:'Microsoft YaHei','PingFang SC','Hiragino Sans GB','Noto Sans CJK SC',sans-serif;font-size:14px;color:#607086;font-weight:400&quot;&gt;   底层样式层 · 被上方绘图函数在内部直接调用&lt;/span&gt;&lt;/div&gt;" style="text=1;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#5A6B80;fontStyle=1;" vertex="1" parent="p3-base">
          <mxGeometry x="22" y="18" width="1600" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p3-base-l0" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;font-family:Consolas,'SF Mono',Menlo,'DejaVu Sans Mono',monospace;font-size:14px;color:#4B5EA8;font-weight:700&quot;&gt;theme_my()&lt;/span&gt;&lt;span style=&quot;font-family:'Microsoft YaHei','PingFang SC','Hiragino Sans GB','Noto Sans CJK SC',sans-serif;font-size:13.5px;color:#607086;font-weight:400&quot;&gt; 与 &lt;/span&gt;&lt;span style=&quot;font-family:Consolas,'SF Mono',Menlo,'DejaVu Sans Mono',monospace;font-size:14px;color:#AE3B2A;font-weight:700&quot;&gt;pal_lancet&lt;/span&gt;&lt;span style=&quot;font-family:'Microsoft YaHei','PingFang SC','Hiragino Sans GB','Noto Sans CJK SC',sans-serif;font-size:13.5px;color:#607086;font-weight:400&quot;&gt; 被 PlotButterfly / PlotRankCor / PlotScatter3 / plt_cat / plt_con / plt_dist / plt_na / plt_upset / plt_alluvial / fmt_plot 内部引用。&lt;/span&gt;&lt;/div&gt;" style="text=1;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Consolas;fontSize=14;fontColor=#5A6B80;fontStyle=0;" vertex="1" parent="p3-base">
          <mxGeometry x="22" y="52" width="2320" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p3-base-l1" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;font-family:Consolas,'SF Mono',Menlo,'DejaVu Sans Mono',monospace;font-size:14px;color:#4B5EA8;font-weight:700&quot;&gt;theme_km / theme_rcs / theme_ROC / theme_heat / theme_sc / theme_scatter / theme_alluvia&lt;/span&gt;&lt;span style=&quot;font-family:'Microsoft YaHei','PingFang SC','Hiragino Sans GB','Noto Sans CJK SC',sans-serif;font-size:13.5px;color:#607086;font-weight:400&quot;&gt; 按图种选用；&lt;/span&gt;&lt;span style=&quot;font-family:Consolas,'SF Mono',Menlo,'DejaVu Sans Mono',monospace;font-size:14px;color:#AE3B2A;font-weight:700&quot;&gt;pal_get() / pal_show*()&lt;/span&gt;&lt;span style=&quot;font-family:'Microsoft YaHei','PingFang SC','Hiragino Sans GB','Noto Sans CJK SC',sans-serif;font-size:13.5px;color:#607086;font-weight:400&quot;&gt; 取色与预览，外部 brewer / ggsci / HCL / viridis 也能一并预览。&lt;/span&gt;&lt;/div&gt;" style="text=1;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Consolas;fontSize=14;fontColor=#5A6B80;fontStyle=0;" vertex="1" parent="p3-base">
